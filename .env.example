# ZLabel Server configuration (copy to .env and adjust; that file is the one the
# API and the inference worker actually read - the old v1 .env.onnx is never read
# again). Every variable is optional: the values below are the defaults.
#
# All variables share the ZLSERVER_ prefix; the API and the worker each read the
# sections they know and ignore the rest. The v1 database is not migrated, so
# ZLSERVER_DATABASE_URL must point at a *new* file.
#
# docker compose reads this same file twice: for ${...} interpolation inside
# docker-compose.yml and as each service's `env_file:`. The ZLABEL_* knobs of
# entrypoint.sh can therefore live here too (see the block at the bottom).

# --- storage ---------------------------------------------------------------
ZLSERVER_DATABASE_URL = "sqlite+pysqlite:///./data/zlabel_server_v2.db"
ZLSERVER_UPLOAD_DIR = "./data/uploads"
# the server owns this directory tree (a mount/NAS path is fine); every top-level
# directory is a project, task images are plain files inside it
ZLSERVER_STORAGE_ROOT = "./data/storage"
# where annotations live inside a project. Empty = ".zlabel/annos" (the desktop's
# dataset layout, so one directory can be used by both sides). A deployment moving
# off the historical "<project>/zlabel" layout runs
# `uv run python -m app.cli migrate-layout --root <STORAGE_ROOT>` and sets this.
ZLSERVER_ANNO_DIR = ""

# --- accounts --------------------------------------------------------------
# "open" = any account may work on any project, "strict" = only the project's
# members (global admins always see everything)
ZLSERVER_PROJECT_ACCESS_MODE = "open"
# first-run bootstrap (only creates the account when it does not exist yet)
ZLSERVER_BOOTSTRAP_ADMIN = ""
ZLSERVER_BOOTSTRAP_PASSWORD = ""

# --- auth / sessions -------------------------------------------------------
ZLSERVER_SESSION_TTL_DAYS = 30
# optional: force this user name (lower-case) to role=admin on login
ZLSERVER_BOOTSTRAP_ADMIN = ""

# --- task lease ------------------------------------------------------------
ZLSERVER_LEASE_MINUTES = 30

# colour forced on auto-created labels. Empty = pick an unused colour from
# the built-in qualitative palette (recommended, keeps labels distinguishable)
ZLSERVER_DEFAULT_LABEL_COLOR = ""

# --- project discovery -----------------------------------------------------
# scan the storage root into the task table once at startup

# --- web administration UI -------------------------------------------------
ZLSERVER_ADMIN_ENABLED = true
ZLSERVER_ADMIN_PATH = "/admin"
# signs the admin UI's cookies. Required whenever the admin UI is enabled: the
# server logs an error and falls back to a public default when this is empty.
ZLSERVER_SECRET_KEY = ""

# --- inference service (separate process) ----------------------------------
ZLSERVER_INFERENCE_URL = "http://127.0.0.1:8001"
# shared secret (API <-> worker, both directions). Set it in production.
ZLSERVER_INFERENCE_TOKEN = ""
ZLSERVER_INFERENCE_TIMEOUT = 180
# true: send the task image with every job; false: the worker pulls it on a cache miss
ZLSERVER_INFERENCE_INLINE_IMAGES = true

# --- model (inference worker) ----------------------------------------------
ZLSERVER_MODEL_NAME = "EdgeSAM"   # SAM / SlimSAM / EdgeSAM / SAM2 / SAM3
ZLSERVER_MODEL_DIR = "assets/onnx"
ZLSERVER_ORT_BACKEND = "CPU"      # CPU / CUDA
ZLSERVER_ORT_THREADS = 8
ZLSERVER_SAM3_CONF = 0.25
ZLSERVER_SAM3_IOU = 0.7
ZLSERVER_CONTOUR_MIN_POINTS = 10
ZLSERVER_CONTOUR_MAX_POINTS = 100
ZLSERVER_CONTOUR_MAX_ITERATIONS = 10
ZLSERVER_MIN_CONTOUR_AREA_RATIO = 3.0e-5
ZLSERVER_EMBEDDING_CACHE_SIZE = 32
ZLSERVER_MAX_CONCURRENCY = 1
ZLSERVER_REQUEST_TIMEOUT = 300
# worker-only: where the pull path fetches task images from
ZLSERVER_API_BASE_URL = "http://127.0.0.1:8000"
ZLSERVER_HOST = "0.0.0.0"
ZLSERVER_PORT = 8001
ZLSERVER_QUEUE_SIZE = 64

# --- docker (docker-compose.yml + entrypoint.sh only) -----------------------
# Read here *and* used for ${...} interpolation, so `docker compose up` needs no
# exported shell variables. Unset/0 = stay root and never touch ./data ownership.
#ZLABEL_UID = 1000
#ZLABEL_GID = 1000
# auto (repair ./data when the storage root belongs to another uid) | always | never
#ZLABEL_CHOWN = auto
# umask for created files; 002 when several operators share the mount
#ZLABEL_UMASK = 022
# ZLABEL_MIGRATE is *not* set here: docker-compose.yml pins it to 1 for the API
# and 0 for the worker, because only the API owns the schema.