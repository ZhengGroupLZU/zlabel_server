# ZLabel Server v2 configuration (copy to .env.v2 and adjust).
# Every variable is optional; the defaults below are the development values.
# The inference worker reads the same file (model + worker sections).

# --- storage ---------------------------------------------------------------
ZLV2_DATABASE_URL = "sqlite+pysqlite:///./data/zlabel_server_v2.db"
ZLV2_UPLOAD_DIR = "./data/uploads"

# --- auth / sessions -------------------------------------------------------
ZLV2_SESSION_TTL_DAYS = 30
# optional: force this user name (lower-case) to role=admin on login
ZLV2_BOOTSTRAP_ADMIN = ""

# --- task lease ------------------------------------------------------------
ZLV2_LEASE_MINUTES = 30

# --- OpenList (identity source + file storage) -----------------------------
ZLV2_OPLIST_HOST = "http://127.0.0.1:5244"
ZLV2_OPLIST_USERNAME = ""
ZLV2_OPLIST_PASSWORD = ""
# static token for the background project scanner (preferred over user/password)
ZLV2_OPLIST_TOKEN = ""
ZLV2_OPLIST_PROJ_DIR = "/zlabel_server/projects"
ZLV2_OPLIST_PROJ_NAME = ""
ZLV2_PROJECT_MARKER = ".zlabel-server-project-root"
ZLV2_PROJECT_SCAN_INTERVAL = 300

# --- inference service (separate process) ----------------------------------
ZLV2_INFERENCE_URL = "http://127.0.0.1:8001"
# shared secret (API <-> worker, both directions). Set it in production.
ZLV2_INFERENCE_TOKEN = ""
ZLV2_INFERENCE_TIMEOUT = 180
# true: send the frame with every job; false: the worker pulls it on a cache miss
ZLV2_INFERENCE_INLINE_IMAGES = true

# --- model (inference worker) ----------------------------------------------
ZLV2_MODEL_NAME = "EdgeSAM"   # SAM / SlimSAM / EdgeSAM / SAM2 / SAM3
ZLV2_MODEL_DIR = "assets/onnx"
ZLV2_ORT_BACKEND = "CPU"      # CPU / CUDA
ZLV2_ORT_THREADS = 8
ZLV2_SAM3_CONF = 0.25
ZLV2_SAM3_IOU = 0.7
ZLV2_EMBEDDING_CACHE_SIZE = 32
ZLV2_MAX_CONCURRENCY = 1
# worker-only: where the pull path fetches frames from
ZLV2_API_BASE_URL = "http://127.0.0.1:8000"
ZLV2_HOST = "0.0.0.0"
ZLV2_PORT = 8001
ZLV2_QUEUE_SIZE = 64
