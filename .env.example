# ZLabel Server configuration (copy to .env.v2 and adjust; that file is the one
# the API and the inference worker actually read - the old v1 .env.onnx is never
# read again). Every variable is optional: the values below are the defaults.
#
# All variables share the ZLSERVER_ prefix; the API and the worker each read the
# sections they know and ignore the rest. The v1 database is not migrated, so
# ZLSERVER_DATABASE_URL must point at a *new* file.

# --- storage ---------------------------------------------------------------
ZLSERVER_DATABASE_URL = "sqlite+pysqlite:///./data/zlabel_server_v2.db"
ZLSERVER_UPLOAD_DIR = "./data/uploads"

# --- storage backend -------------------------------------------------------
# "openlist" = proxy an external file service; "local" = the server owns a tree
ZLSERVER_STORAGE_BACKEND = "openlist"
ZLSERVER_STORAGE_ROOT = "./data/storage"
# where annotations live inside a project. Empty = "zlabel" for the openlist
# backend (existing deployments) and ".zlabel/annos" for the local backend.
# Set it explicitly to switch an OpenList deployment after migrate-layout.
ZLSERVER_ANNO_DIR = ""

# --- identity --------------------------------------------------------------
# "openlist" = accounts live in the external service; "local" = ours (scrypt)
ZLSERVER_IDENTITY = "openlist"
# first-run bootstrap for local accounts (only created when missing)
ZLSERVER_BOOTSTRAP_ADMIN = ""
ZLSERVER_BOOTSTRAP_PASSWORD = ""

# --- auth / sessions -------------------------------------------------------
ZLSERVER_SESSION_TTL_DAYS = 30
# optional: force this user name (lower-case) to role=admin on login
ZLSERVER_BOOTSTRAP_ADMIN = ""

# --- task lease ------------------------------------------------------------
ZLSERVER_LEASE_MINUTES = 30

# colour used when an annotation introduces an unknown label
ZLSERVER_DEFAULT_LABEL_COLOR = "#000000"

# --- OpenList (identity source + file storage) -----------------------------
ZLSERVER_OPLIST_HOST = "http://127.0.0.1:5244"
ZLSERVER_OPLIST_USERNAME = ""
ZLSERVER_OPLIST_PASSWORD = ""
# static token for the background project scanner (preferred over user/password)
ZLSERVER_OPLIST_TOKEN = ""
ZLSERVER_OPLIST_PROJ_DIR = "/zlabel_server/projects"
ZLSERVER_OPLIST_PROJ_NAME = ""
ZLSERVER_PROJECT_MARKER = ".zlabel-server-project-root"
ZLSERVER_PROJECT_SCAN_INTERVAL = 300
# scan OpenList into the task table once at startup
ZLSERVER_SCAN_ON_STARTUP = true

# --- inference service (separate process) ----------------------------------
ZLSERVER_INFERENCE_URL = "http://127.0.0.1:8001"
# shared secret (API <-> worker, both directions). Set it in production.
ZLSERVER_INFERENCE_TOKEN = ""
ZLSERVER_INFERENCE_TIMEOUT = 180
# true: send the frame with every job; false: the worker pulls it on a cache miss
ZLSERVER_INFERENCE_INLINE_IMAGES = true

# --- model (inference worker) ----------------------------------------------
ZLSERVER_MODEL_NAME = "EdgeSAM"   # SAM / SlimSAM / EdgeSAM / SAM2 / SAM3
ZLSERVER_MODEL_DIR = "assets/onnx"
ZLSERVER_ORT_BACKEND = "CPU"      # CPU / CUDA
ZLSERVER_ORT_THREADS = 8
ZLSERVER_SAM3_CONF = 0.25
ZLSERVER_SAM3_IOU = 0.7
ZLSERVER_CONTOUR_MIN_POINTS = 10
ZLSERVER_CONTOUR_MAX_POINTS = 100
ZLSERVER_CONTOUR_MAX_ITERATIONS = 10
ZLSERVER_MIN_CONTOUR_AREA_RATIO = 3.0e-5
ZLSERVER_EMBEDDING_CACHE_SIZE = 32
ZLSERVER_MAX_CONCURRENCY = 1
ZLSERVER_REQUEST_TIMEOUT = 300
# worker-only: where the pull path fetches frames from
ZLSERVER_API_BASE_URL = "http://127.0.0.1:8000"
ZLSERVER_HOST = "0.0.0.0"
ZLSERVER_PORT = 8001
ZLSERVER_QUEUE_SIZE = 64
